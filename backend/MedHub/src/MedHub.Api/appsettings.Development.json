{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=medhub;Username=postgres;Password=postgres;SslMode=Disable;Include Error Detail=true",
    "Cache": "medhub-redis:6379"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://medhub-seq:5341" }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Authentication": {
    "Audience": "account",
    "ValidIssuer": "http://medhub-idp:8080/realms/medhub",
    "MetadataUrl": "http://medhub-idp:8080/realms/medhub/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "BaseUrl": "http://medhub-idp:8080",
    "AdminUrl": "http://medhub-idp:8080/admin/realms/medhub/",
    "TokenUrl": "http://medhub-idp:8080/realms/medhub/protocol/openid-connect/token",
    "AdminClientId": "medhub-admin-client",
    "AdminClientSecret": "UZDmbNxWmV4TlpaCRcju6pMRsyuV3er1",
    "AuthClientId": "medhub-auth-client",
    "AuthClientSecret": "3E3yvXaYppoYBF3Ir6DgtEzADKKzSurZ"
  },
  "Outbox": {
    "IntervalInSeconds": 10,
    "BatchSize": 10
  }
}
